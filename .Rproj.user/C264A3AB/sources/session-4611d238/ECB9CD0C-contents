# instalar programas
install.packages(c("devtools", "roxygen2", "testthat", "rcmdcheck", 
                   "urlchecker", "spelling", "covr", "pkgdown", "rhub",
                   "knitr", "rmarkdown"))

#verificar que los paquestes estén
devtools::dev_sitrep()


# 1. Carga el paquete sin instalarlo (rápido, para iterar)
devtools::load_all()

# 2. Probá una función a mano para confirmar que está vivo
tr_classic(base_rate = 0.20, selection_ratio = 0.10, validity = 0.50)
# Tendría que devolver un objeto con ppv ≈ 0.515

# 3. Corré todos los tests
devtools::test()
# Esperás ver: "[ FAIL 0 | WARN 0 | SKIP 0 | PASS 200+ ]"


# 5a. Regenerar los archivos .Rd a partir de los #' en el código.
#     Si no cambiaste el código no es estrictamente necesario, pero es buena
#     práctica correrlo siempre que abras el paquete.
devtools::document()

# 5b. Construir las vignettes para verlas
devtools::build_vignettes()
# Esto deja archivos .html en doc/. Abrí cualquiera para revisar:
browseURL("doc/utility-analysis-taxonomy.html")
browseURL("doc/reproductions.html")

# 5c. (Opcional pero muy recomendado) Construir el sitio pkgdown localmente
pkgdown::build_site()
# Abre automáticamente en el navegador. Es el sitio que aparecerá en
# rgempp.github.io/personnelSelectionUtility/ cuando hagas push.
devtools::build_manual()

devtools::check()
devtools::check(args = "--as-cran")
devtools::check(args = "--as-cran", manual = TRUE)






