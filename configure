#!/bin/sh
# Ensure that the installed package has a doc directory before R writes
# the vignette index during source installation. This avoids keeping
# inst/doc in the editable source tree, which would trigger devtools' prompt
# about deleting generated vignette artifacts during package builds.
if [ -d inst ]; then
  mkdir -p inst/doc
  if [ ! -f inst/doc/index.html ]; then
    cat > inst/doc/index.html <<'EOF'
<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>personnelSelectionUtility vignettes</title></head><body></body></html>
EOF
  fi
fi
